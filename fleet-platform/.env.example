# =============================================================
# Fleet Platform — Environment Variables
# =============================================================
# Source this file: source /opt/fleet-platform/.env
# Hoặc copy vào ~/.bashrc

# --- Cluster Hostnames ---
FLEET_MASTER=master
FLEET_SLAVE1=slave1
FLEET_SLAVE2=slave2
FLEET_USER=aiguystory

# --- Hadoop HDFS ---
HADOOP_HOME=/opt/hadoop
HADOOP_CONF_DIR=/opt/hadoop/etc/hadoop
HDFS_NAMENODE_URL=hdfs://master:9000
FLEET_DATALAKE_ROOT=/fleet-datalake

# --- Kafka ---
KAFKA_HOME=/opt/kafka
KAFKA_BOOTSTRAP_SERVERS=master:9092,slave1:9092,slave2:9092
KAFKA_ZOOKEEPER=master:2181

# --- PostgreSQL (Odoo OLTP) ---
POSTGRES_HOST=master
POSTGRES_PORT=5432
FLEET_OLTP_DB=fleet_oltp
FLEET_OLTP_USER=fleet_app
FLEET_OLTP_PASSWORD=fleet_app_2024

# --- PostgreSQL (CDC User) ---
FLEET_CDC_USER=fleet_cdc
FLEET_CDC_PASSWORD=fleet_cdc_2024

# --- PostgreSQL (Airflow Metadata) ---
AIRFLOW_DB=airflow_metadata
AIRFLOW_DB_USER=airflow_user
AIRFLOW_DB_PASSWORD=airflow_2024

# --- Redis ---
REDIS_HOST=master
REDIS_PORT=6379

# --- Spark ---
SPARK_HOME=/opt/spark
SPARK_MASTER_URL=spark://master:7077
SPARK_MASTER_WEBUI=http://master:8080

# --- Debezium / Kafka Connect ---
KAFKA_CONNECT_URL=http://master:8083

# --- Airflow ---
AIRFLOW_HOME=/home/aiguystory/airflow
AIRFLOW_WEBUI=http://master:8081

# --- WebSocket Backend (sẽ tạo ở Ticket 6) ---
WEBSOCKET_PORT=8765
