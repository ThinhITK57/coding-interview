# Cron schedule format: minute hour day month weekday
CRON_SCHEDULE=*/30 * * * *

# Run one immediate job when container starts
RUN_ON_STARTUP=true

# Script and target domains (comma-separated)
DBT_SCRIPT=/workspace/dbt_projects/scripts/s3-build-upload-openmetadata-local.sh
DBT_DOMAINS=crm
DBT_RUN_ARGS=

# dbt env file consumed by s3-build-upload-openmetadata-local.sh
ENV_FILE=/workspace/dbt_projects/.env.s3.local

# Optional: pull latest source from branch before each run
ENABLE_GIT_PULL=false
GIT_BRANCH=master
GIT_LAST_SHA_FILE=/var/lib/metadata-agent/last_master.sha

# Optional: trigger OpenMetadata DBT ingestion after S3 upload succeeds
ENABLE_OM_DBT_TRIGGER=false
OM_HOST=http://localhost:8585
# OM_API_HOSTPORT=http://localhost:8585/api
OM_JWT=
OM_VERIFY_SSL=true
OM_DATABASE_SERVICE_NAME=
# all | first | name
OM_DBT_TRIGGER_MODE=all
OM_DBT_PIPELINE_NAME=
OM_REQUEST_TIMEOUT=30
OM_RETRY_MAX_ATTEMPTS=4
OM_RETRY_INITIAL_DELAY_SECONDS=1
OM_RETRY_MAX_DELAY_SECONDS=8
