# =============================
# OpenMetadata target
# =============================
# Base URL of OpenMetadata server (without /api suffix)
OM_HOST=http://localhost:8585

# Optional override for metadata ingest hostPort.
# Default: ${OM_HOST}/api
# OM_API_HOSTPORT=http://localhost:8585/api

# =============================
# Authentication (choose ONE)
# =============================
# 1) Direct JWT token
# OM_JWT=eyJraWQiOi...

# 2) Username/password login to fetch JWT automatically
# Note: OpenMetadata login API expects base64(password)
# and script handles that internally.
# OM_USER=ingestion-bot@open-metadata.org
# OM_PASS=your_password

# Usually keep this as openmetadata
OM_AUTH_PROVIDER=openmetadata

# =============================
# dbt execution
# =============================
# Optional: root directory containing dbt projects.
# Default is parent folder of scripts/, usually dbt_projects.
# DBT_PROJECTS_ROOT=/workspace/dbt_projects

# Optional, comma-separated projects. If empty, all projects under DBT_PROJECTS_ROOT are processed.
# DBT_PROJECTS=crm,cx,finance

# Set true to skip tests during dbt build
DBT_SKIP_TESTS=false

# Optional: set dbt target profile
# DBT_TARGET=staging

# =============================
# OpenMetadata dbt options
# =============================
# OM_DBT_UPDATE_DESCRIPTIONS=true
# OM_DBT_UPDATE_OWNERS=true
# OM_DBT_INCLUDE_TAGS=true
# OM_DBT_CLASSIFICATION_NAME=dbtTags

# Logging and workflow behavior
OM_LOG_LEVEL=INFO
OM_STORE_SERVICE_CONNECTION=false

# Optional: associate external run with an existing ingestion pipeline
# OM_INGESTION_PIPELINE_FQN=my_service.my_dbt_pipeline

# =============================
# SSL options
# =============================
# OM_VERIFY_SSL=ignore   # or validate
# OM_SSL_CA_CERT_PATH=/path/to/ca.pem

# =============================
# dbt/Trino runtime (if using Trino)
# =============================
# DBT_TRINO_HOST=10.0.247.157
# DBT_TRINO_PORT=8443
# DBT_TRINO_USER=admin
# DBT_TRINO_PASSWORD=your_password
# DBT_TRINO_CATALOG=hive
# DBT_TRINO_SCHEMA=bi_silver
# DBT_THREADS=8
# DBT_TRINO_HTTP_SCHEME=https
# DBT_TRINO_AUTH=ldap
# DBT_TRINO_SSL_VERIFY=false

# Optional: for self-signed TLS environments
# NODE_TLS_REJECT_UNAUTHORIZED=0

# Optional model materialization override
# DBT_MATERIALIZED=ephemeral

# =============================
# Optional FQN normalization before upload
# =============================
# Supports {project} template
# OM_FQN_DATABASE=hive
# OM_FQN_SCHEMA=bi_gold
# OM_FQN_LOWERCASE=true
