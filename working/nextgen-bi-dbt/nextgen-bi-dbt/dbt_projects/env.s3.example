# Copy this file to .env.s3.local or .env.s3.prod
# and update values for each environment.

############################
# 1) DBT runtime settings
############################

# Optional: root directory containing dbt projects.
# Default is the parent folder of scripts/, usually dbt_projects.
# DBT_PROJECTS_ROOT=/workspace/dbt_projects

# Optional: project selector when no CLI args are passed.
# Accepts comma or space separated project names/paths.
# Example: DBT_PROJECTS=finance,cx
# DBT_PROJECTS=finance cx
# DBT_PROJECTS=finance

############################
# 2) Upload destination
############################

# Destination prefix for OpenMetadata dbt artifacts.
# Final files will be:
# - <S3_DBT_PREFIX>/<project>/manifest.json
# - <S3_DBT_PREFIX>/<project>/catalog.json
# - <S3_DBT_PREFIX>/<project>/run_results.json
S3_DBT_PREFIX=s3://metadata/dbt

############################
# 3) AWS auth and region
############################

# Choose ONE auth strategy:
# - Use AWS_PROFILE
# - Or use access key + secret key (+ optional session token)

# AWS_PROFILE=default

# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_SESSION_TOKEN=your_session_token

# Region can be required by some providers/CLI configs.
AWS_REGION=ap-southeast-1
# AWS_DEFAULT_REGION=ap-southeast-1

############################
# 4) S3-compatible endpoint (MinIO, etc.)
############################

# Uncomment when using S3-compatible storage instead of AWS S3.
# AWS_ENDPOINT_URL=http://localhost:9000
# AWS_S3_FORCE_PATH_STYLE=true

############################
# 5) Optional examples
############################

# Example for local MinIO:
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_REGION=us-east-1
# AWS_ENDPOINT_URL=http://localhost:9000
# AWS_S3_FORCE_PATH_STYLE=true
# S3_DBT_PREFIX=s3://metadata/dbt

# Example for production AWS S3:
# AWS_PROFILE=prod
# AWS_REGION=ap-southeast-1
# S3_DBT_PREFIX=s3://metadata/dbt


# Optional target env for dbt
DBT_TARGET=staging

# Trino connection used by all domain projects
DBT_TARGET=staging
DBT_TRINO_HOST=
DBT_TRINO_PORT=443
DBT_TRINO_USER=-datamining
DBT_TRINO_PASSWORD=
DBT_TRINO_CATALOG=hive
DBT_TRINO_SCHEMA=bi_silver
DBT_THREADS=8
DBT_TRINO_HTTP_SCHEME=https
DBT_TRINO_AUTH=ldap
DBT_TRINO_SSL_VERIFY=false

NODE_TLS_REJECT_UNAUTHORIZED=0

DBT_MATERIALIZED=ephemeral

OM_FQN_DATABASE=hive
OM_FQN_SCHEMA=bi_silver
OM_FQN_LOWERCASE=true

# Optional: normalize model materialization in manifest.json for OpenMetadata.
# true (default): coerce model config.materialized ephemeral -> view.
# false: keep original manifest materialization values.
OM_COERCE_EPHEMERAL_TO_VIEW=true