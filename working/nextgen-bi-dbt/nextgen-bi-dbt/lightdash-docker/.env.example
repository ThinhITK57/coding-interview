# Lightdash local environment example
# Copy this file to .env.lightdash and update values for your environment.

# Required secrets
PGPASSWORD=StrongPassword_ChangeMe
LIGHTDASH_SECRET=ReplaceWithLongRandomSecretAtLeast32Chars

# Postgres
PGHOST=db
PGPORT=5432
PGUSER=postgres
PGDATABASE=postgres

# Lightdash web
PORT=8080
SITE_URL=http://localhost:8080
SECURE_COOKIES=false
TRUST_PROXY=false

# Mounted dbt project path (host -> /usr/app/dbt in container)
DBT_PROJECT_DIR=./nextgen_bi

# S3/MinIO for Lightdash artifacts
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=lightdash
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# dbt Trino profile environment
DBT_TARGET=dev
DBT_TRINO_HOST=trino-host
DBT_TRINO_PORT=8443
DBT_TRINO_USER=admin
DBT_TRINO_PASSWORD=ChangeMe
DBT_TRINO_CATALOG=hive
DBT_TRINO_SCHEMA=bi_silver
DBT_THREADS=8
DBT_TRINO_HTTP_SCHEME=https
DBT_TRINO_AUTH=ldap
DBT_TRINO_SSL_VERIFY=false

NODE_TLS_REJECT_UNAUTHORIZED=0

AI_COPILOT_ENABLED=true
LIGHTDASH_ENABLE_FEATURE_FLAGS=ai-custom-viz
ASK_AI_BUTTON_ENABLED=true

OPENAI_API_KEY=sk-xxx
AI_DEFAULT_PROVIDER=openai
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small


# AI_DEFAULT_PROVIDER=azure

# AZURE_AI_API_KEY=xxx
# AZURE_AI_ENDPOINT=https://xxx.openai.azure.com
# AZURE_AI_API_VERSION=2024-02-01
# AZURE_AI_DEPLOYMENT_NAME=gpt-4o
# AZURE_EMBEDDING_DEPLOYMENT_NAME=text-embedding


# AI_DEFAULT_PROVIDER=openrouter

# OPENROUTER_API_KEY=xxx
# OPENROUTER_MODEL_NAME=openai/gpt-4o-mini


AI_EMBEDDING_ENABLED=true
AI_DEFAULT_EMBEDDING_PROVIDER=openai


AI_COPILOT_DEBUG_LOGGING_ENABLED=false
AI_COPILOT_TELEMETRY_ENABLED=false


AI_COPILOT_MAX_QUERY_LIMIT=1000
AI_VERIFIED_ANSWER_SIMILARITY_THRESHOLD=0.7