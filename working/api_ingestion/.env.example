# ==============================================================================
# API Ingestion & Prefect HQ Configuration Template
# Copy file này thành .env trên máy bạn và điền các giá trị thực tế
# ==============================================================================

# Địa chỉ Prefect HQ Server của công ty (Server đã dựng sẵn)
# Ví dụ: http://192.168.1.50:4200/api hoặc http://prefect.company.internal:4200/api
PREFECT_API_URL=http://localhost:4200/api

# Tên Work Pool trên Prefect HQ server mà worker này sẽ join vào
PREFECT_WORK_POOL_NAME=default-agent-pool

# Môi trường chạy pipeline: dev | staging | prod
ENV=dev

# Static API Key để gọi tới REST API nguồn (ví dụ Clarizen API Key)
PROJECT_API_KEY=your_secret_api_key_here
